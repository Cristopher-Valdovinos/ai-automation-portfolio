# Copia este archivo como .env y ajusta los valores

# URL de Ollama. Con docker compose usa http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Nombre exacto del modelo, tal como aparece en `ollama list`
OLLAMA_MODEL=llama3.2

# Segundos máximos de espera por respuesta del modelo
OLLAMA_TIMEOUT=120
